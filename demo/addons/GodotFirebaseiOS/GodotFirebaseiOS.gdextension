[configuration]
entry_symbol = "swift_entry_point"
compatibility_minimum = 4.4

[libraries]
macos.debug.x86_64 = "stubs/libstub_macos.dylib"
macos.release.x86_64 = "stubs/libstub_macos.dylib"
macos.debug.arm64 = "stubs/libstub_macos.dylib"
macos.release.arm64 = "stubs/libstub_macos.dylib"
ios.debug = "frameworks/GodotFirebaseiOS.xcframework"
ios.release = "frameworks/GodotFirebaseiOS.xcframework"
windows.debug.x86_64 = "stubs/stub.dll"
windows.release.x86_64 = "stubs/stub.dll"
android.debug.arm64 = "stubs/libstub_android.so"
android.release.arm64 = "stubs/libstub_android.so"
android.debug.x86_64 = "stubs/libstub_android.so"
android.release.x86_64 = "stubs/libstub_android.so"

[dependencies]
ios = {
    "res://addons/GodotApplePluginsRuntime/bin/SwiftGodotRuntime.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/AppAuth.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/AppCheckCore.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FBLPromises.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseABTesting.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseAnalytics.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseAppCheckInterop.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseAuth.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseAuthInterop.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseCore.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseCoreExtension.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseCoreInternal.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseDatabase.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseFirestore.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseFirestoreInternal.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseInstallations.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseMessaging.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseMessagingInterop.xcframework": "",
    "res://addons/GodotFirebaseiOS/frameworks/FirebaseRemoteConfig.xcframework": "",
